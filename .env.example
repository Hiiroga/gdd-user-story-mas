# ─── Foundation LLM ───────────────────────────────────────────────────────────
# API key for the chosen foundation LLM provider (never commit the real value)
LLM_API_KEY=

# Which provider to instantiate (must match a key in config/models.yaml once created)
# Example values: openai | anthropic | gemini
LLM_PROVIDER=

# ─── Environment ──────────────────────────────────────────────────────────────
# Controls logging verbosity and validation strictness.
# Values: dev | experiment
# IMPORTANT: Do NOT use this to change pipeline behaviour that affects results.
GDD_USERSTORY_MAS_ENV=dev
